# ============================================================
# Enterprise AI Control Plane - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_control_plane

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------
# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Ollama base URL (default: local Docker service)
OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------------
# Admin Dashboard
# ------------------------------------------------------------
# Simple API key for the admin dashboard (optional extra layer)
ADMIN_API_KEY=

# ------------------------------------------------------------
# Policy
# ------------------------------------------------------------
# Path to the YAML policy file (relative to project root)
POLICY_FILE=policies/policy.yaml
